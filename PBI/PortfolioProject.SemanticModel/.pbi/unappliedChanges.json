    {
      "name": "fnGetNBPrates",
      "lineageTag": "2905dfd3-0256-4f9d-9b76-abe5b8517bf1",
      "queryGroupId": "bfec40c3-ab4f-4e16-ba50-0edb46ddb95e",
      "text": [
        "(DateFrom as date, DateTo as date, CurrencyCode as text) =>",
        "let",
        "    DateFromText = Date.ToText(DateFrom, [Format = \"yyyy-MM-dd\"]),",
        "    DateToText   = Date.ToText(DateTo,   [Format = \"yyyy-MM-dd\"]),",
        "    Source = Json.Document(",
        "        Web.Contents(",
        "            \"https://api.nbp.pl/api/exchangerates/rates\",",
        "            [",
        "                RelativePath = \"a/\" & Text.Lower(CurrencyCode) & \"/\" & DateFromText & \"/\" & DateToText,",
        "                Query = [format = \"json\"]",
        "            ]",
        "        )",
        "    ),",
        "    Rates = Source[rates],",
        "    RatesTable = Table.FromList(Rates, Splitter.SplitByNothing(), {\"Rate\"}),",
        "    Expanded = Table.ExpandRecordColumn(RatesTable, \"Rate\", {\"effectiveDate\", \"mid\"}),",
        "    Typed = Table.TransformColumnTypes(Expanded, {{\"effectiveDate\", type date}, {\"mid\", type number}})",
        "in",
        "    Typed"
      ],
      "loadAsTableDisabled": true,
      "resultType": "Function",
      "isHidden": false
    },
    {
      "name": "fnCleanBudgetSheet",
      "lineageTag": "c708213a-6be3-4441-a1ed-631fbb668f1a",
      "queryGroupId": "bfec40c3-ab4f-4e16-ba50-0edb46ddb95e",
      "text": [
        "(pSheetName as text) => let",
        "  Source = BudgetSheets,",
        "  Navigation = Source{[Item = pSheetName, Kind = \"Sheet\"]}[Data],",
        "  #\"Removed top rows\" = Table.Skip(Navigation, each [Column1] <> \"Country\"),",
        "  #\"Promoted headers\" = Table.PromoteHeaders(#\"Removed top rows\", [PromoteAllScalars = true]),",
        "  #\"Filled down\" = Table.FillDown(#\"Promoted headers\", {\"Country\", \"Channel\"}),",
        "  #\"Filtered rows\" = Table.SelectRows(#\"Filled down\", each not Text.Contains([Country], \"Total\")),",
        "  #\"Choose columns\" = Table.SelectColumns(#\"Filtered rows\", {\"Country\", \"Channel\", \"Category\", \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"}),",
        "  #\"Unpivoted other columns\" = Table.UnpivotOtherColumns(#\"Choose columns\", {\"Country\", \"Channel\", \"Category\"}, \"Attribute\", \"Value\"),",
        "  #\"Renamed columns\" = Table.RenameColumns(#\"Unpivoted other columns\", {{\"Attribute\", \"Month\"}})",
        "in",
        "  #\"Renamed columns\""
      ],
      "loadAsTableDisabled": true,
      "resultType": "Function",
      "isHidden": false
    },

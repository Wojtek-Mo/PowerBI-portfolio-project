		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Best Possible DSO' =
			
			VAR Last3Months =
			    DATESINPERIOD(
			        DimDate[Date],
			        MAX( DimDate[Date] ),
			        -3,
			        MONTH
			    )
			
			VAR PeriodStart =
			    MINX( Last3Months, DimDate[Date] )
			
			VAR FirstInvoiceDate =
			    CALCULATE(
			        MIN( FactInvoices[InvoiceDate] ),
			        REMOVEFILTERS( DimDate )
			    )
			
			VAR Last3MonthsInvoiced =
			    CALCULATE(
			        [Invoiced Amount],
			        Last3Months
			    )
			
			VAR Avg3mNotDue =
			    AVERAGEX(
			        CALCULATETABLE(
			            VALUES( DimDate[YearMonthNumber] ),
			            Last3Months
			        ),
			        [Open AR] - [Overdue AR]
			    )
			
			VAR DaysInPeriod =
			    COUNTROWS( Last3Months )
			
			RETURN
			    IF(
			        PeriodStart < FirstInvoiceDate,
			        BLANK(),
			        DIVIDE( Avg3mNotDue, Last3MonthsInvoiced ) * DaysInPeriod
			    )
		displayFolder: 5. Receivables
		lineageTag: 06958f2a-8745-44a7-8148-75fdf051078a

		annotation PBI_FormatHint = {"isGeneralNumber":true}


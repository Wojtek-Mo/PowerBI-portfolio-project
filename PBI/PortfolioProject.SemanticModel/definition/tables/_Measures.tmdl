	measure 'Open AR Aging' = ```
			
			VAR LastDayofMonth = MAX( DimDate[Date] )
			VAR LowerBound = SELECTEDVALUE( 'Aging Buckets'[MinDays] )
			VAR UpperBound = SELECTEDVALUE( 'Aging Buckets'[MaxDays] )
			VAR DueFrom = LastDayofMonth - UpperBound
			VAR DueTo = LastDayofMonth - LowerBound
			RETURN
			IF(
			    HASONEVALUE( 'Aging Buckets'[AgingBucket] ),
			    CALCULATE(
			        [Open AR],
			        FactInvoices[DueDate] >= DueFrom,
			        FactInvoices[DueDate] <= DueTo
			    ),
			    [Open AR]
			)
			
			
			
			
			
			
			
			
			```
		displayFolder: 5. Receivables
		lineageTag: 601481ab-82a8-4db6-854c-57d5190c9d32

		formatStringDefinition = "\$#,0.0;(\$#,0.0);\$#,0.0"

	measure DSO =
			
			VAR Last3Months =
			    DATESINPERIOD(
			        DimDate[Date],
			        MAX( DimDate[Date] ),
			        -3,
			        MONTH
			    )
			
			VAR PeriodStart =
			    MINX( Last3Months, DimDate[Date] )
			
			VAR FirstInvoiceDate =
			    CALCULATE(
			        MIN( FactInvoices[InvoiceDate] ),
			        REMOVEFILTERS( DimDate )
			    )
			
			VAR Last3MonthsInvoiced =
			    CALCULATE(
			        [Invoiced Amount],
			        Last3Months
			    )
			
			VAR AvgReceivables3m =
			    AVERAGEX(
			        CALCULATETABLE(
			            VALUES( DimDate[YearMonthNumber] ),
			            Last3Months
			        ),
			        [Open AR]
			    )
			
			VAR DaysInPeriod =
			    COUNTROWS( Last3Months )
			
			RETURN
			    IF(
			        PeriodStart < FirstInvoiceDate,
			        BLANK(),
			        DIVIDE( AvgReceivables3m, Last3MonthsInvoiced ) * DaysInPeriod
			    )
		formatString: 0.0
		displayFolder: 5. Receivables
		lineageTag: ac817d3b-213d-4927-97dc-554d20cc43b5


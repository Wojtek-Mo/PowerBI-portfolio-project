	measure 'Variance to budget YTD Max label' = ```
			
			VAR CurrentValue = [Net Sales Δ BU YTD]
			VAR CurrentMonth = SELECTEDVALUE(DimDate[MonthNumber])
			VAR LastMonth =
			    MAXX(
			        ALLSELECTED( DimDate[MonthShort], DimDate[MonthNumber] ),
			        DimDate[MonthNumber]
			    )
			RETURN
			IF(
			    CurrentMonth = LastMonth,
			    CurrentValue,
			    BLANK()
			)
			
			
			```

table _Measures
	lineageTag: db649de3-e987-4e45-a058-f8e353648a4b

	/// Sales after discounts (NetPrice * Quantity). Main revenue measure
	measure 'Net Sales' =
			
			SUMX(
			    FactSales,
			    FactSales[NetPrice] * FactSales[Quantity]
			)
		displayFolder: 1. Base Measures
		lineageTag: 2b349450-b5a8-4d79-8bf4-71eff7ebdcab

		formatStringDefinition = "\$#,0.0;(\$#,0.0);\$#,0.0"

	/// Sales at list price, before discounts (UnitPrice * Quantity)
	measure 'Gross Sales' =
			
			SUMX(
			    FactSales,
			    FactSales[UnitPrice] * FactSales[Quantity]
			)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 1. Base Measures
		lineageTag: 657c84bf-4a75-4003-8616-c27d72ce04a7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Cost of goods sold (UnitCost * Quantity)
	measure Cost =
			
			SUMX(
			    FactSales,
			    FactSales[UnitCost] * FactSales[Quantity]
			)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 1. Base Measures
		lineageTag: 90422a93-b9f3-49c4-85a4-64dbea0f01d8

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Net Sales minus Cost: profit on goods sold, before other operating costs
	measure 'Gross Margin' = [Net Sales] - [Cost]
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 1. Base Measures
		lineageTag: 11fe219f-39b6-4e3c-bc74-2660b2701940

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Value of discounts granted: Gross Sales minus Net Sales
	measure Discount = [Gross Sales] - [Net Sales]
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 1. Base Measures
		lineageTag: 48b7b74e-8217-4981-86b3-392c9306475e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Gross Margin as a share of Net Sales
	measure 'Gross Margin %' =
			
			DIVIDE(
			    [Gross Margin],
			    [Net Sales]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Base Measures
		lineageTag: 3878a387-1b5a-47c4-91cc-605ff98c0ff1

	/// Number of units sold (sum of Quantity)
	measure 'Units Sold' = SUM(FactSales[Quantity])
		formatString: 0.0
		displayFolder: 1. Base Measures
		lineageTag: 2617b1ca-d7b5-4702-9fd8-8a67ddce2a89

	/// Number of distinct orders (distinct OrderKey)
	measure Orders = DISTINCTCOUNT(FactSales[OrderKey])
		formatString: 0.0
		displayFolder: 1. Base Measures
		lineageTag: d89cd2e0-c337-4782-b9df-1b3e6faa46b3

	measure 'Header Date' =
			
			"Data as of " &
			FORMAT(
			    CALCULATE(
			        MAX(DimDate[Date]),
			        ALL(DimDate)),
			        "dd mmm YYYY")
		displayFolder: 9. Report Labels
		lineageTag: 417bfc66-85da-42ec-89c4-a19da758bf39

	measure 'Net Sales Δ PY %' = ```
			CALCULATE([Net Sales], Comparison[Comparison] = "Δ PY %")
			
			
			```
		displayFolder: 2. KPI Helpers
		lineageTag: 1c0107c1-949d-4068-b3ea-a5257c3a457e

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Gross Margin Δ PY %' = CALCULATE([Gross Margin], Comparison[Comparison] = "Δ PY %")
		displayFolder: 2. KPI Helpers
		lineageTag: a7701898-9581-42a8-93f0-b3f90eee301e

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Gross Margin Δ PY p.p.' = ```
			
			CALCULATE([Gross Margin %], Comparison[Comparison] = "Δ PY") * 100
			
			
			```
		displayFolder: 2. KPI Helpers
		lineageTag: 820caf65-2a46-4344-b392-93ccecc37fc3

		formatStringDefinition = "+0.0 \p\p;-0.0 \p\p;0.0 \p\p"

	measure 'Orders Δ PY %' = CALCULATE([Orders], Comparison[Comparison] = "Δ PY %")
		displayFolder: 2. KPI Helpers
		lineageTag: e2a8b3d4-4036-44c4-9f05-8da99eed2ccf

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Net Sales PY' =
			
			CALCULATE(
			    [Net Sales],
			    Comparison[Comparison] = "PY")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 8. Visual Helpers
		lineageTag: 289820ca-bd94-41bd-a9c7-b6370226e436

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Sales Δ PY' = ```
			
			CALCULATE(
			    [Net Sales],
			    Comparison[Comparison] = "Δ PY"
			)
			
			```
		displayFolder: 8. Visual Helpers
		lineageTag: ef188147-1a37-486b-9abd-597c4765bafe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales Δ PY%' =
			
			CALCULATE(
			    [Net Sales],
			    Comparison[Comparison] ="Δ PY %"
			    )
		displayFolder: 8. Visual Helpers
		lineageTag: 111c4a6e-e196-4f23-8348-4d34e6613af1

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Net Sales PY Dummy' = ```
			
			IF(
			    ISINSCOPE(DimCustomer[CountryName]),
			    [Net Sales Δ PY]
			)
			    
			```
		displayFolder: 8. Visual Helpers
		lineageTag: bda046fc-a6fa-460d-b2df-270d660e43b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Share in Sales' = ```
			
			VAR TotalSalesContext =
			CALCULATE( 
			    [Net Sales],
			    REMOVEFILTERS(DimCustomer[CountryName]),
			    REMOVEFILTERS(DimStore[SalesChannel])
			)
			RETURN 
			DIVIDE([Net Sales], TotalSalesContext)
			```
		lineageTag: 13a10c3b-40ce-43f2-a674-4d1ad8743471

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Units Sold PY' =
			
			CALCULATE(
			    [Units Sold],
			    Comparison[Comparison] = "PY"
			)
		formatString: 0
		displayFolder: 4. PVM
		lineageTag: 8b32ec35-252a-4361-b392-8c08c7c5ec2d

	measure 'Avg Price' = DIVIDE(CONVERT([Net Sales], DOUBLE), [Units Sold])
		displayFolder: 4. PVM
		lineageTag: 0917ed10-e1c0-402f-90b2-567bb145acc7

		formatStringDefinition = "$#,0.00"

	measure 'Avg Price PY' = ```
			
			CALCULATE(
			    [Avg Price],
			    Comparison[Comparison] = "PY"
			)
			
			```
		displayFolder: 4. PVM
		lineageTag: ac91a3c5-594c-4c88-9841-a90b6b34f274

		formatStringDefinition = "$#,0.00"

	measure 'Price Effect' =
			
			SUMX(
			    VALUES(DimProduct[ProductKey]),
			    IF(
			        [Units Sold] > 0 &&
			        [Units Sold PY] > 0,
			        [Units Sold] * ([Avg Price] - [Avg Price PY])
			    )
			)
		displayFolder: 4. PVM
		lineageTag: 5824d121-be2f-4e43-ae53-968fe6e32714

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Effect' = ```
			
			--1. Finding products with sales in CY and PY
			VAR ComparableProducts =
			    FILTER(
			        VALUES(DimProduct[ProductKey]),
			        [Units Sold] > 0 &&
			        [Units Sold PY] > 0
			    )
			
			--2. Sum of all comparable product
			VAR UnitsAC = SUMX(ComparableProducts, [Units Sold])
			VAR UnitsPY = SUMX(ComparableProducts, [Units Sold PY])
			
			--3. Average price for comparable products
			VAR SalesPY =SUMX(ComparableProducts, [Net Sales PY])
			VAR AveragePricePY = DIVIDE(CONVERT(SalesPY, DOUBLE), UnitsPY)
			
			--4. Volume Effect
			RETURN
			(UnitsAC - UnitsPY) * AveragePricePY
			
			        
			    
			        
			    
			```
		displayFolder: 4. PVM
		lineageTag: 4d774d41-d6ea-49b2-8c2e-929a1fe59a46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mix Effect' = ```
			
			--1. Comparable products
			VAR ComparableProducts = 
			FILTER(
			    VALUES(DimProduct[ProductKey]),
			    [Units Sold] > 0 &&
			    [Units Sold PY] > 0
			)
			
			--2. Sum of comparable products
			VAR UnitsPY = SUMX(ComparableProducts, [Units Sold PY])
			VAR UnitsAC = SUMX(ComparableProducts, [Units Sold])
			
			--3. SalesPY
			VAR SalesPY = SUMX(ComparableProducts, [Net Sales PY])
			
			--4. AveragePricePY
			VAR GroupAvgPricePY = DIVIDE(CONVERT(SalesPY, DOUBLE), UnitsPY)
			
			--5. AC units valued at PY price
			VAR SalesAC_at_PYprice =
			    SUMX(ComparableProducts, 
			    [Units Sold] * [Avg Price PY]
			    )
			
			--6. Mix Effect
			RETURN 
			SalesAC_at_PYprice - (UnitsAC * GroupAvgPricePY)
			
			```
		displayFolder: 4. PVM
		lineageTag: 86fe7683-f4ef-475d-bf97-1b1b712cdebf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New/Discontinued Effect' = ```
			
			--1. Uncomparable produdcts
			VAR NewProducts = 
			FILTER(
			    VALUES(DimProduct[ProductKey]),
			    [Units Sold] > 0 &&
			    ISBLANK([Units Sold PY])
			)
			
			VAR DiscontinuedProducts =
			FILTER(
			    VALUES(DimProduct[ProductKey]),
			    ISBLANK([Units Sold]) &&
			    [Units Sold PY] > 0
			)
			
			--2. NewSales
			VAR NewSales = 
			SUMX(
			    NewProducts,
			    [Net Sales]
			)
			
			VAR DiscontinuedSales =
			SUMX(
			    DiscontinuedProducts,
			    [Net Sales PY]
			)
			
			--3. New/Discontinued Effect
			RETURN
			NewSales - DiscontinuedSales
			
			
			
			
			
			```
		displayFolder: 4. PVM
		lineageTag: 9714a6ae-a5ab-4c50-bb67-03eb426c3e51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PVM Bridge Value' = ```
			
			VAR CurrentStep = SELECTEDVALUE('PVM Steps'[Step])
			RETURN
			SWITCH(
			    CurrentStep,
			    "PY", [Net Sales PY],
			    "Price", [Price Effect],
			    "Volume", [Volume Effect],
			    "Mix", [Mix Effect],
			    "New/Discontinued", [New/Discontinued Effect]
			)
			
			
			```
		displayFolder: 4. PVM
		lineageTag: 42347404-c687-42c6-bf84-0cad26177237

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'USD/PLN Rate' = SELECTEDVALUE(FactExchangeRate[UsdPlnRate])
		displayFolder: 8. Visual Helpers
		lineageTag: 5128dd15-4ab7-497a-8600-05a4b91cde03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales BU' = SUM(FactBudget[NetSalesBU])
		formatString: $#,0.0,,"M";($#,0.0,,"M")
		displayFolder: 6. Budget
		lineageTag: 9afe9e15-c246-4f0b-868c-82f589027088

		annotation PBI_FormatHint = {"isCustom":true}

	/// Budgeted number of units
	measure 'Units Sold BU' = SUM(FactBudget[UnitsBU])
		formatString: " $#,0.0,,""M"";($#,0.0,,""M"")"
		displayFolder: 6. Budget
		lineageTag: e34087c0-18ef-40b8-a109-0df18a426f9c

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Net Sales Δ BU' = ```
			
			IF(
			    ISBLANK([Net Sales BU]),
			    BLANK(),
			    [Net Sales] - [Net Sales BU] 
			)
			```
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 6. Budget
		lineageTag: 067a762c-eb02-46f9-8c61-55ecafa422e1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Sales Δ BU %' = DIVIDE([Net Sales Δ BU], [Net Sales BU])
		displayFolder: 6. Budget
		lineageTag: 2343c889-a46a-411e-a509-14f8de17e6fd

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Units Sold Δ BU' = ```
			
			IF(
			    ISBLANK([Units Sold BU]),
			    BLANK(),
			    [Units Sold] - [Units Sold BU] 
			)
			
			```
		formatString: 0.00
		displayFolder: 6. Budget
		lineageTag: efdf6e23-2c74-47f1-9344-300973857062

	measure 'Units Sold Δ BU %' = DIVIDE( [Units Sold Δ BU], [Units Sold BU])
		displayFolder: 6. Budget
		lineageTag: 04c1a591-1ba0-49e8-ae9e-ab4c949f880e

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Net Sales BU FY' = ```
			
			VAR CurrentYear = SELECTEDVALUE( DimDate[Year] )
			
			RETURN
			CALCULATE(
			    [Net Sales BU],
			    REMOVEFILTERS( DimDate[Date], DimDate[Year], DimDate[Month], DimDate[MonthShort] ), 
			    DimDate[Year] = CurrentYear
			)
			```
		formatString: $#,0.0;($#,0.0)
		displayFolder: 6. Budget
		lineageTag: b9de8433-48d9-4a79-a11c-cfe59206eb97

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Net Sales Δ BU YTD' =
			
			CALCULATE(
			    [Net Sales Δ BU],
			    DATESYTD(DimDate[Date])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 6. Budget
		lineageTag: cf23234e-42b9-4ff4-acdf-0d69a399aaa5

	measure 'Title Variance Breakdown' =
			
			VAR prmState = SELECTEDVALUE('Variance Breakdown prm'[Variance Breakdown prm Order])
			
			RETURN
			"Variance to budget by " &
			SWITCH(
			    prmState,
			    0, "country",
			    1, "category"
			)
		displayFolder: 9. Report Labels
		lineageTag: 34eea9f5-2b08-4136-8fdb-91359a7b7311

		annotation PBI_FormatHint = {"isGeneralNumber":true}


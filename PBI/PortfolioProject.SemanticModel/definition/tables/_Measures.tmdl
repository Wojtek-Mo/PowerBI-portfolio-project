	measure 'Open AR' = ```
			
			VAR LastDayofMonth = MAX( DimDate[Date] )
			
			VAR Invoiced = 
			CALCULATE(
			    [Invoiced Amount],
			    REMOVEFILTERS( DimDate ),
			    DimDate[Date] <= LastDayofMonth
			)
			
			VAR Collected =
			CALCULATE(
			    [Cash Collected],
			    REMOVEFILTERS( DimDate ),
			    DimDate[Date] <= LastDayofMonth,
			    NOT ISBLANK(FactPayments[OrderKey])
			)
			
			RETURN
			Invoiced - Collected
			```
		formatString: "  $#,0.0;($#,0.0)"
		displayFolder: 5. Receivables
		lineageTag: 8f172adc-0d24-4ad7-80f2-0d41b61db2e1

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Overdue AR' =
			
			VAR LastDayofMonth = MAX( DimDate[Date] )
			RETURN
			CALCULATE(
			    [Open AR],
			    FactInvoices[DueDate] < LastDayofMonth
			)
		formatString: "  $#,0.0;($#,0.0)"

table Comparison
	lineageTag: fe4a69d4-9c2c-4968-ac01-b777eb07e4e1

	calculationGroup
		precedence: 10

		calculationItem AC = SELECTEDMEASURE()

		calculationItem PY = ```
				
				CALCULATE(
				    SELECTEDMEASURE(),
				    SAMEPERIODLASTYEAR(DimDate[Date])
				)
				
				
				
				```

		calculationItem 'Δ PY' = ```
				
				VAR PY = CALCULATE(
				    SELECTEDMEASURE(),
				    SAMEPERIODLASTYEAR(DimDate[Date])
				)
				RETURN
				SELECTEDMEASURE() - PY
				
				```

		calculationItem 'Δ PY %' = ```
				
				VAR PY = CALCULATE(
				    SELECTEDMEASURE(),
				    SAMEPERIODLASTYEAR(DimDate[Date])
				)
				VAR DeltaPY = SELECTEDMEASURE() - PY
				RETURN
				DIVIDE( DeltaPY, PY ) 
				```

			formatStringDefinition = "0.0%"


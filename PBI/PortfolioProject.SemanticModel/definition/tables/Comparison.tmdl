table Comparison
	lineageTag: fe4a69d4-9c2c-4968-ac01-b777eb07e4e1

	calculationGroup
		precedence: 10

		calculationItem AC = SELECTEDMEASURE()

		calculationItem PY = ```
				
				VAR CurrentValue = SELECTEDMEASURE()
				VAR PreviousValue =
				    CALCULATE(
				        SELECTEDMEASURE(),
				        SAMEPERIODLASTYEAR(DimDate[Date])
				    )
				RETURN
				IF(
				    ISBLANK( PreviousValue ) || ISBLANK( CurrentValue ),
				    BLANK(),
				    PreviousValue
				)
				
				
				```

		calculationItem 'Δ PY' = ```
				
				VAR CurrentValue = SELECTEDMEASURE()
				VAR PreviousValue =
				    CALCULATE(
				        SELECTEDMEASURE(),
				        SAMEPERIODLASTYEAR( DimDate[Date] )
				    )
				RETURN
				IF(
				    ISBLANK( PreviousValue ) || ISBLANK( CurrentValue ),
				    BLANK(),
				    CurrentValue - PreviousValue
				)
				
				```

		calculationItem 'Δ PY %' = ```
				
				VAR CurrentValue = SELECTEDMEASURE()
				VAR PreviousValue =
				    CALCULATE(
				        SELECTEDMEASURE(),
				        SAMEPERIODLASTYEAR( DimDate[Date] )
				    )
				VAR DeltaPY = CurrentValue - PreviousValue
				RETURN
				IF(
				    ISBLANK( PreviousValue ) || ISBLANK( CurrentValue ),
				    BLANK(),
				    DIVIDE( DeltaPY, PreviousValue )
				)
				
				```

			formatStringDefinition = "0.0%"


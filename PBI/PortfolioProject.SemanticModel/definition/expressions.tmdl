expression BudgetSheets =
		let
		    Source = Excel.Workbook(File.Contents(pBudgetFilePath), null, true),
		    SheetsOnly = Table.SelectRows(Source, each [Kind] = "Sheet" and [Name] <> "Cover")
		in
		    SheetsOnly
	lineageTag: 91ed7d3f-81ea-4a93-84e4-407f4a27257c

expression BudgetMapping =
		let
		    Source = #table(
		        type table [SourceCategory = text, CategoryName = text],
		        {
		            {"Audio", "Audio"},
		            {"Computers", "Computers"},
		            {"TV & Video", "TV and Video"},
		            {"Mobile Phones", "Cell phones"},
		            {"Cameras & Camcorders", "Cameras and camcorders"},
		            {"Music, Movies & Audiobooks", "Music, Movies and Audio Books"},
		            {"Games & Toys", "Games and Toys"},
		            {"Home appliances", "Home Appliances"}
		        }
		    )
		in
		    Source
	lineageTag: 4914cda0-046e-4ff8-88e9-8bfeeda48eab

model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","DaxQueryView_Desktop","CalcGroup"]

annotation PBI_QueryOrder = ["DimCustomer","DimDate","DimProduct","DimStore","FactSales"]

ref table DimCustomer
ref table DimDate
ref table DimProduct
ref table DimStore
ref table FactSales
ref table _Measures
ref table 'Period View'
ref table Comparison
ref table 'PVM Steps'

ref cultureInfo en-US


model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '4. Dimensions'

	annotation PBI_QueryGroupOrder = 4

queryGroup '5. Facts'

	annotation PBI_QueryGroupOrder = 5

queryGroup '2. Functions'

	annotation PBI_QueryGroupOrder = 1

queryGroup '3. Staging'

	annotation PBI_QueryGroupOrder = 3

queryGroup '1. Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2. Functions\Payments Queries\Transform file from PaymentOld'

	annotation PBI_QueryGroupOrder = 1

queryGroup '2. Functions\Payments Queries\Transform file from PaymentOld\Helper queries'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2. Functions\Payments Queries\Transform file from PaymentNew'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2. Functions\Payments Queries\Transform file from PaymentNew\Helper queries (2)'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2. Functions\Payments Queries'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","DaxQueryView_Desktop","CalcGroup"]

annotation PBI_QueryOrder = ["DimCustomer","DimDate","DimProduct","DimStore","DimCategory","DimChannel","DimCountry","FactSales","FactExchangeRate","FactBudget","FactPayments","FactInvoices","fnGetNBPrates","fnCleanBudgetSheet","BudgetMapping","BudgetSheets","NbpPeriodsHelper","NbpRates","NbpCalendar","PaymentFiles","pBudgetFilePath","pPaymentsFolderPath","PaymentOld","PaymentNew","Sample file","Parameter","Transform Sample file","Transform file","Sample file (2)","Parameter (2)","Transform Sample file (2)","Transform file (2)"]

ref table DimCustomer
ref table DimDate
ref table DimProduct
ref table DimStore
ref table FactSales
ref table _Measures
ref table 'Period View'
ref table Comparison
ref table 'PVM Steps'
ref table FactExchangeRate
ref table FactBudget
ref table DimCategory
ref table DimChannel
ref table DimCountry
ref table prmVarianceBreakdown
ref table FactPayments
ref table FactInvoices
ref table 'Aging Buckets'

ref cultureInfo en-US


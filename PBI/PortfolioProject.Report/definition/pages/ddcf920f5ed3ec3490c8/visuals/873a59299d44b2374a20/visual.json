        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Select the year and month at the top. Month / YTD / Full Year sets the period on Overview and Budget vs actual. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• On Receivables the selected month is the balance date: figures are balances at month end, charts show the whole year. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Filters (top right): country, channel, category. Reset restores the defaults. Channel and category do not apply to receivables. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• AC = actual, PY = prior year, BU = budget. \"vs PY\" and \"vs budget\" show the difference; pp = percentage points. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• All amounts in USD; large values in millions."
                  }
                ]
              }
            ]
          }
        }
      ]
